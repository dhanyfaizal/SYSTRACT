VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_GOOGLE_API_KEY=your-google-api-key

# Hanya untuk server (Vercel Function api/ai.js). JANGAN diberi awalan VITE_,
# karena semua variabel VITE_ ikut terkirim ke browser.
SUMOPOD_API_KEY=your-sumopod-key
SUMOPOD_API_URL=https://ai.sumopod.com/v1

# Pemantauan error (opsional). Kosongkan untuk mematikan. DSN Sentry bukan rahasia (aman di browser).
VITE_SENTRY_DSN=
